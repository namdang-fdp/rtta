SPEECH_KEY=YOUR_SPEECH_KEY
# Retained for the preserved spike; the S03 adapter uses SPEECH_KEY + SPEECH_REGION.
SPEECH_ENDPOINT=https://koreacentral.api.cognitive.microsoft.com/
SPEECH_REGION=koreacentral
SPEECH_SOURCE_LANGUAGE=en-US
SPEECH_TARGET_LANGUAGE=vi

RTTA_TRANSLATION_PROVIDER=azure
# Intentionally disabled by default as a product policy.
RTTA_TRANSLATION_PHRASE_LIST_ENABLED=false
RTTA_TRANSLATION_PHRASE_LIST_WEIGHT=1.1
RTTA_TRANSLATION_PHRASE_LIST_TERMS=pulsar,neutron star,radio telescope,magnetic field
RTTA_TRANSLATION_AZURE_SDK_LOG_FILE=
# Development quota guard. Use 0s to disable it outside local development.
RTTA_TRANSLATION_DEVELOPMENT_SESSION_LIMIT=120s

# Local household/device authentication. Use different high-entropy production values.
RTTA_HOUSEHOLD_CODE=replace-for-local-development
RTTA_EXTENSION_DEVICE_TOKEN=replace-for-local-development
RTTA_SESSION_COOKIE_SECURE=false
RTTA_SESSION_TIMEOUT=14d
RTTA_WEB_ALLOWED_ORIGINS=http://localhost:3000
# Replace with the actual unpacked extension Origin for strict local testing.
RTTA_EXTENSION_ALLOWED_ORIGINS=chrome-extension://local-development

RTTA_DB_HOST=localhost
RTTA_DB_PORT=5432
RTTA_DB_NAME=rtta
RTTA_DB_USER=rtta
RTTA_DB_PASSWORD=change-me-for-local-development

RTTA_MINIO_ENDPOINT=http://localhost:9000
RTTA_MINIO_ACCESS_KEY=rtta-local
RTTA_MINIO_SECRET_KEY=change-me-for-local-development
RTTA_MINIO_RECORDINGS_BUCKET=rtta-recordings
RTTA_MINIO_DOCUMENTS_BUCKET=rtta-documents
# Recording storage is approximately 32 KB/s (about 576 MB for five hours) before object-store overhead.
# Optional override: RTTA_RECORDING_TEMP_DIRECTORY=/tmp/rtta-recordings
RTTA_DOCUMENT_MAX_SIZE_BYTES=52428800
# Optional override: RTTA_DOCUMENT_TEMP_DIRECTORY=/tmp/rtta-documents

# Server-side only. Never use NEXT_PUBLIC_ or expose these values to the browser.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.7-flash
# Optional. QUICK remains available when no distinct deep model is configured.
GEMINI_DEEP_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Approximate input size for each chronological intermediate summary.
RTTA_SUMMARY_CHUNK_CHARACTER_BUDGET=60000

SPIKE_PHRASE_LIST_ENABLED=true
SPIKE_PHRASE_LIST_WEIGHT=1.5
SPIKE_PHRASE_LIST_TERMS=eigenstate,eigenstates,eigenvalue,eigenvalues,eigenfunction,Hamiltonian,quantum state,wave function,Schrodinger equation,Schrödinger equation

SPIKE_AUDIO_PATH=./samples/physics.pcm
SPIKE_AUDIO_SECONDS_LIMIT=20
SPIKE_CHUNK_MS=50
