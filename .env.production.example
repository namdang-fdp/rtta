# Container images (use main or immutable sha-<commit>)
RTTA_API_IMAGE=ghcr.io/namdang-fdp/rtta-api:main
RTTA_WEB_IMAGE=ghcr.io/namdang-fdp/rtta-web:main
RTTA_INFRA_NETWORK=replace-with-existing-private-docker-network

# Database
RTTA_DB_HOST=replace-with-private-postgres-hostname
RTTA_DB_PORT=5432
RTTA_DB_NAME=rtta
RTTA_DB_USER=replace-me
RTTA_DB_PASSWORD=replace-me

# Private S3-compatible object storage
RTTA_MINIO_ENDPOINT=https://replace-with-private-storage-endpoint
RTTA_MINIO_ACCESS_KEY=replace-me
RTTA_MINIO_SECRET_KEY=replace-me
RTTA_MINIO_RECORDINGS_BUCKET=rtta-recordings
RTTA_MINIO_DOCUMENTS_BUCKET=rtta-documents

# Azure Speech
SPEECH_KEY=replace-me
SPEECH_REGION=replace-me
SPEECH_SOURCE_LANGUAGE=en-US
SPEECH_TARGET_LANGUAGE=vi
RTTA_TRANSLATION_PROVIDER=azure

# Gemini
GEMINI_API_KEY=replace-me
GEMINI_MODEL=replace-me
GEMINI_DEEP_MODEL=
GEMINI_EMBEDDING_MODEL=replace-me

# Shared household authentication for RTTA Web and the extension
RTTA_HOUSEHOLD_CODE=replace-me
RTTA_SESSION_COOKIE_SECURE=true
RTTA_SESSION_TIMEOUT=14d

# Exact credentialed web Origins; comma-separated values are supported
RTTA_WEB_ALLOWED_ORIGINS=https://temthui.dorriss.com

# Public web runtime configuration (not secrets)
RTTA_PUBLIC_API_URL=https://api-rtta.dorriss.com
RTTA_PUBLIC_LIVE_WS_URL=wss://api-rtta.dorriss.com/ws/live
# Production extension artifact is built with: wss://api-rtta.dorriss.com/ws/audio

# Optional tuning
RTTA_TRANSLATION_DEVELOPMENT_SESSION_LIMIT=0s
RTTA_TRANSLATION_PHRASE_LIST_ENABLED=false
RTTA_TRANSLATION_PHRASE_LIST_WEIGHT=1.1
RTTA_TRANSLATION_PHRASE_LIST_TERMS=
RTTA_TRANSLATION_AZURE_SDK_LOG_FILE=
RTTA_RECORDING_TEMP_DIRECTORY=/tmp/rtta-recordings
RTTA_DOCUMENT_TEMP_DIRECTORY=/tmp/rtta-documents
RTTA_DOCUMENT_MAX_FILE_SIZE=50MB
RTTA_DOCUMENT_MAX_SIZE_BYTES=52428800
RTTA_DOCUMENT_CHUNK_SIZE=1200
RTTA_DOCUMENT_CHUNK_OVERLAP=150
RTTA_DOCUMENT_MAX_CHUNKS=500
RTTA_EMBEDDING_BATCH_SIZE=20
RTTA_SUMMARY_CHUNK_CHARACTER_BUDGET=60000
