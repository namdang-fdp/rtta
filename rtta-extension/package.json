{
  "name": "rtta-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt -b chrome",
    "build": "wxt build -b chrome && node scripts/validate-built-extension.mjs",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/chrome": "0.2.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@wxt-dev/module-react": "1.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "jsdom": "30.0.1",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "web-ext": "10.6.0",
    "wxt": "0.21.4"
  }
}
